      "name": "Load Scoring Rules"
    },
    {
      "parameters": {
        "jsCode": "const rules = $input.all().map(item => item.json);\n\nconst lead = $(\"Receive Canonical Lead\").first().json;\n\nfunction getScore(factor, value) {\n  const rule = rules.find(r =>\n    r.factor === factor &&\n    r.value === value\n  );\n\n  return rule?.score ?? 0;\n}\n\nconst breakdown = {\n  urgency: getScore(\"urgency\", lead.urgency),\n  serviceType: getScore(\"serviceType\", lead.serviceType),\n  propertyType: getScore(\"propertyType\", lead.propertyType),\n  source: getScore(\"source\", lead.source)\n};\n\nconst score = Object.values(breakdown)\n  .reduce((total, value) => total + value, 0);\n\nreturn [\n  {\n    json: {\n      ...lead,\n      score,\n      scoreBreakdown: breakdown\n    }\n  }\n];"
      },
